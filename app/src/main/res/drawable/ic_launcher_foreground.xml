<?xml version="1.0" encoding="utf-8"?>
<!--
  LifePilot logo — a minimalist compass pointing toward a north star.
  Concept: LifePilot quietly guides users toward what deserves their attention.
  Thin circle outline, needle, and a small four-pointed star at true north.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer thin circle -->
    <path
        android:strokeColor="#6B8FD4"
        android:strokeWidth="2.5"
        android:fillColor="@android:color/transparent"
        android:pathData="M54,18 A36,36 0 1,1 53.99,18 Z" />

    <!-- Compass needle — north half (pointing to star), bright blue -->
    <path
        android:fillColor="#6B8FD4"
        android:pathData="M54,23 L57.5,50 L54,52.5 L50.5,50 Z" />

    <!-- Compass needle — south half, muted -->
    <path
        android:fillColor="#2A3E60"
        android:pathData="M54,82 L57.5,56 L54,52.5 L50.5,56 Z" />

    <!-- Small pivot dot at centre -->
    <path
        android:fillColor="#6B8FD4"
        android:pathData="M54,50 m-3,0 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0" />

    <!-- North star — four-pointed, at top of circle -->
    <path
        android:fillColor="#B8CFFF"
        android:pathData="M54,13 L55.4,16.5 L59,17 L55.9,19.8 L56.8,23.5 L54,21.5 L51.2,23.5 L52.1,19.8 L49,17 L52.6,16.5 Z" />

</vector>
