<?xml version="1.0" encoding="utf-8"?>
<!-- LifePilot brand mark: a compass — outer ring, cardinal ticks, and a two-tone N–S needle.
     The elongated, two-colour needle (not a symmetric star) is what makes it read as a compass. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer guide ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.34"
        android:strokeWidth="2.5"
        android:pathData="M22,54 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0" />

    <!-- Cardinal ticks (N, E, S, W) just inside the ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.6"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M54,26 L54,31 M82,54 L77,54 M54,82 L54,77 M26,54 L31,54" />

    <!-- Needle — north half: tall, bright, clearly points UP -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,28 L49,54 L59,54 Z" />

    <!-- Needle — south half: shorter, narrower, muted (a counterweight, so north dominates) -->
    <path
        android:fillColor="#8B98D6"
        android:pathData="M54,73 L50.5,54 L57.5,54 Z" />

    <!-- Center hub (teal accent) -->
    <path
        android:fillColor="#5EC4B6"
        android:pathData="M49.6,54 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0" />
</vector>
