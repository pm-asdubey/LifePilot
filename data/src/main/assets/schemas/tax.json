{
  "objectType": "tax",
  "displayName": "Tax Record",
  "domain": "finance",
  "icon": "Receipt",
  "description": "Annual income tax filing or tax-related document",
  "metadataFields": [
    {"fieldId": "tax_year","label": "Tax Year","type": "TEXT","required": true,"placeholder": "2024-25"},
    {"fieldId": "filing_status","label": "Filing Status","type": "ENUM","required": true,"enumValues": ["NOT_FILED","FILED","ASSESSED","REFUND_RECEIVED","TAX_DUE"]},
    {"fieldId": "filing_date","label": "Filing Date","type": "DATE","required": false,"placeholder": "YYYY-MM-DD"},
    {"fieldId": "due_date","label": "Due Date","type": "DATE","required": false,"placeholder": "YYYY-MM-DD"},
    {"fieldId": "income_total","label": "Total Income","type": "NUMBER","required": false,"placeholder": "50000"},
    {"fieldId": "tax_paid","label": "Tax Paid","type": "NUMBER","required": false,"placeholder": "12000"},
    {"fieldId": "refund_amount","label": "Refund Amount","type": "NUMBER","required": false,"placeholder": "0"},
    {"fieldId": "reference_number","label": "Reference / UTR Number","type": "TEXT","required": false,"placeholder": "UTR or national reference"}
  ],
  "lifecycle": {"states": ["PENDING","FILED","ASSESSED","CLOSED"],"initialState": "PENDING"},
  "reminderRules": [
    {"ruleId": "tax_filing_reminder","name": "Tax Filing Due","triggerField": "due_date","offsetDays": -30,"priority": "HIGH","messageTemplate": "Tax filing due in 30 days"}
  ],
  "aiExtractionConfig": {"extractableFields": ["tax_year","filing_date","income_total","tax_paid","reference_number"],"confidenceThreshold": 0.8}
}
