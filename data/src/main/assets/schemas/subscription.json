      {"fromState": "PAUSED","toState": "ACTIVE","trigger": "RESUME","label": "Resumed"},
      {"fromState": "ACTIVE","toState": "CANCELLED","trigger": "CANCEL","label": "Cancelled"}
    ],
    "initialState": "ACTIVE"
  },
  "reminderRules": [
