{
  "objectType": "subscription",
  "displayName": "Subscription",
  "domain": "Finance",
  "icon": "Subscriptions",
  "description": "Software, streaming, or service subscriptions",
  "schemaVersion": 1,
  "fields": [
    {"fieldId": "service_name","displayName": "Service Name","fieldType": "TEXT","required": true,"editable": true,"searchable": true,"aiExtractable": true,"validationRules": [],"placeholder": "Netflix, Spotify, etc."},
    {"fieldId": "plan_name","displayName": "Plan","fieldType": "TEXT","required": false,"editable": true,"searchable": false,"aiExtractable": true,"validationRules": [],"placeholder": "Premium, Basic, etc."},
    {"fieldId": "billing_cycle","displayName": "Billing Cycle","fieldType": "ENUM","required": true,"editable": true,"searchable": false,"aiExtractable": true,"validationRules": [],"enumValues": ["MONTHLY","QUARTERLY","ANNUALLY","WEEKLY"]},
    {"fieldId": "amount","displayName": "Amount","fieldType": "NUMBER","required": true,"editable": true,"searchable": false,"aiExtractable": true,"validationRules": [],"placeholder": "9.99"},
    {"fieldId": "currency","displayName": "Currency","fieldType": "TEXT","required": false,"editable": true,"searchable": false,"aiExtractable": true,"validationRules": [],"placeholder": "USD"},
    {"fieldId": "renewal_date","displayName": "Next Renewal Date","fieldType": "DATE","required": true,"editable": true,"searchable": false,"aiExtractable": true,"validationRules": [],"placeholder": "YYYY-MM-DD"},
