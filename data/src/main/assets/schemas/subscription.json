  "searchConfig": {"primaryFields": ["service_name","plan_name"],"fullTextFields": ["service_name"],"filterableFields": ["billing_cycle","status"]},
  "aiConfig": {"extractableFields": ["service_name","billing_cycle","amount","renewal_date"],"classificationHints": ["subscription","renewal","billing"]}
