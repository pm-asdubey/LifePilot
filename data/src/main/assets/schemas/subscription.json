{
  "objectType": "subscription",
  "displayName": "Subscription",
  "domain": "finance",
  "icon": "Subscriptions",
  "description": "Software, streaming, or service subscriptions",
  "metadataFields": [
    {
      "fieldId": "service_name",
      "label": "Service Name",
      "type": "TEXT",
      "required": true,
      "placeholder": "Netflix, Spotify, etc."
    },
    {
      "fieldId": "plan_name",
      "label": "Plan",
      "type": "TEXT",
      "required": false,
      "placeholder": "Premium, Basic, etc."
    },
    {
      "fieldId": "billing_cycle",
      "label": "Billing Cycle",
      "type": "ENUM",
      "required": true,
      "enumValues": ["MONTHLY", "QUARTERLY", "ANNUALLY", "WEEKLY"]
    },
    {
      "fieldId": "amount",
      "label": "Amount",
      "type": "NUMBER",
      "required": true,
      "placeholder": "9.99"
    },
    {
      "fieldId": "currency",
      "label": "Currency",
      "type": "TEXT",
      "required": false,
      "placeholder": "USD"
    },
    {
      "fieldId": "renewal_date",
      "label": "Next Renewal Date",
      "type": "DATE",
      "required": true,
      "placeholder": "YYYY-MM-DD"
    },
    {
      "fieldId": "status",
      "label": "Status",
      "type": "ENUM",
      "required": true,
      "enumValues": ["ACTIVE", "PAUSED", "CANCELLED", "TRIAL"]
    },
    {
      "fieldId": "payment_method",
      "label": "Payment Method",
      "type": "TEXT",
      "required": false,
      "placeholder": "Visa ending 1234"
    }
  ],
  "lifecycle": {
    "states": ["ACTIVE", "PAUSED", "CANCELLED"],
    "initialState": "ACTIVE"
  },
  "reminderRules": [
    {
      "ruleId": "renewal_reminder",
      "name": "Renewal Reminder",
      "triggerField": "renewal_date",
      "offsetDays": -7,
      "priority": "NORMAL",
      "messageTemplate": "Your {service_name} subscription renews in 7 days"
    }
  ],
  "aiExtractionConfig": {
    "extractableFields": ["service_name", "billing_cycle", "amount", "renewal_date"],
    "confidenceThreshold": 0.8
  }
}
