{
  "objectType": "bank_account",
  "domain": "Finance",
  "displayName": "Bank Account",
  "icon": "account_balance",
  "description": "Bank accounts and financial accounts",
  "schemaVersion": 1,
  "fields": [
    {
      "fieldId": "bank_name",
      "displayName": "Bank / Institution",
      "fieldType": "TEXT",
      "required": true,
      "editable": true,
      "searchable": true,
      "aiExtractable": true,
      "validationRules": [{"ruleType": "min_length", "parameter": "2", "message": "Bank name required"}]
    },
    {
      "fieldId": "account_type",
      "displayName": "Account Type",
      "fieldType": "ENUM",
      "required": true,
      "editable": true,
      "searchable": true,
      "aiExtractable": true,
      "validationRules": [],
      "enumValues": ["CURRENT", "SAVINGS", "JOINT", "BUSINESS", "FIXED_DEPOSIT", "OTHER"]
    },
    {
      "fieldId": "account_number_last4",
      "displayName": "Last 4 Digits",
      "fieldType": "TEXT",
      "required": false,
      "editable": true,
      "searchable": false,
      "aiExtractable": false,
      "validationRules": [{"ruleType": "max_length", "parameter": "4", "message": "Enter last 4 digits only"}],
      "hint": "For identification only — do not store full account number"
    },
    {
      "fieldId": "branch",
      "displayName": "Branch",
      "fieldType": "TEXT",
      "required": false,
      "editable": true,
      "searchable": false,
      "aiExtractable": true,
      "validationRules": []
    },
    {
      "fieldId": "ifsc_sort_swift",
      "displayName": "IFSC / Sort Code / SWIFT",
      "fieldType": "TEXT",
      "required": false,
      "editable": true,
      "searchable": false,
      "aiExtractable": true,
      "validationRules": []
    },
    {
      "fieldId": "currency",
      "displayName": "Currency",
      "fieldType": "TEXT",
      "required": false,
      "editable": true,
      "searchable": false,
      "aiExtractable": true,
      "validationRules": []
    }
  ],
  "lifecycle": {
    "initialState": "active",
    "states": [
      {"stateId": "active", "displayName": "Active"},
      {"stateId": "closed", "displayName": "Closed", "isFinal": true}
    ],
    "transitions": [
      {"fromState": "active", "toState": "closed", "trigger": "CLOSE_ACCOUNT", "label": "Close Account"}
    ]
  },
  "reminderRules": [],
  "searchConfig": {
    "primaryFields": ["bank_name", "account_type"],
    "fullTextFields": ["bank_name", "account_type", "branch"],
    "filterableFields": ["account_type"]
  },
  "aiConfig": {
    "extractableFields": ["bank_name", "account_type", "branch", "ifsc_sort_swift", "currency"],
    "classificationHints": ["bank statement", "account", "balance", "passbook", "cheque book"]
  }
}
