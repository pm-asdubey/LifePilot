      },
      {
        "stateId": "RENEWAL_DUE",
        "displayName": "Renewal Due"
      },
      {
        "stateId": "EXPIRED",
        "displayName": "Expired"
      },
      {
        "stateId": "ARCHIVED",
        "displayName": "Archived",
        "isFinal": true
      }
    ],
    "transitions": [
      {
