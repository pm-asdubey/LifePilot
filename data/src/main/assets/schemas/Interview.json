      "aiExtractable": true,
      "validationRules": [
        {
          "ruleType": "REQUIRED",
          "message": "Company name is required"
        }
      ],
      "sensitivityLevel": "SENSITIVE"
    },
    {
      "fieldId": "role",
      "displayName": "Role",
      "fieldType": "TEXT",
      "required": false,
      "editable": true,
      "searchable": true,
      "aiExtractable": true,
      "validationRules": [],
      "sensitivityLevel": "STANDARD"
    },
    {
      "fieldId": "applicationDate",
      "displayName": "Application Date",
      "fieldType": "DATE",
      "required": false,
      "editable": true,
      "searchable": false,
      "aiExtractable": true,
      "validationRules": [],
