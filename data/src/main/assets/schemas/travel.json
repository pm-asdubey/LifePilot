{
  "objectType": "travel",
  "displayName": "Travel",
  "domain": "travel",
  "icon": "Flight",
  "description": "Trip, visa, or travel document",
  "schemaVersion": 1,
  "fields": [
    {"fieldId": "destination","displayName": "Destination","fieldType": "TEXT","required": true,"editable": true,"searchable": true,"aiExtractable": true,"validationRules": [],"placeholder": "London, UK"},
    {"fieldId": "travel_type","displayName": "Travel Type","fieldType": "ENUM","required": true,"editable": true,"searchable": false,"aiExtractable": false,"validationRules": [],"enumValues": ["HOLIDAY","BUSINESS","RELOCATION","MEDICAL","EDUCATION"]},
    {"fieldId": "departure_date","displayName": "Departure Date","fieldType": "DATE","required": false,"editable": true,"searchable": false,"aiExtractable": true,"validationRules": [],"placeholder": "YYYY-MM-DD"},
    {"fieldId": "return_date","displayName": "Return Date","fieldType": "DATE","required": false,"editable": true,"searchable": false,"aiExtractable": true,"validationRules": [],"placeholder": "YYYY-MM-DD"},
    {"fieldId": "visa_required","displayName": "Visa Required","fieldType": "ENUM","required": false,"editable": true,"searchable": false,"aiExtractable": false,"validationRules": [],"enumValues": ["YES","NO","NOT_SURE"]},
    {"fieldId": "visa_expiry","displayName": "Visa Expiry","fieldType": "DATE","required": false,"editable": true,"searchable": false,"aiExtractable": true,"validationRules": [],"placeholder": "YYYY-MM-DD"},
    {"fieldId": "booking_reference","displayName": "Booking Reference","fieldType": "TEXT","required": false,"editable": true,"searchable": true,"aiExtractable": true,"validationRules": [],"placeholder": "ABC123"},
    {"fieldId": "airline","displayName": "Airline / Carrier","fieldType": "TEXT","required": false,"editable": true,"searchable": true,"aiExtractable": true,"validationRules": [],"placeholder": "British Airways"}
  ],
  "lifecycle": {
    "states": [
      {"stateId": "PLANNING","displayName": "Planning"},
      {"stateId": "BOOKED","displayName": "Booked"},
      {"stateId": "IN_PROGRESS","displayName": "In Progress"},
      {"stateId": "COMPLETED","displayName": "Completed","isFinal": true},
      {"stateId": "CANCELLED","displayName": "Cancelled","isFinal": true}
    ],
    "transitions": [
      {"fromState": "PLANNING","toState": "BOOKED","trigger": "BOOKED","label": "Booked"},
      {"fromState": "BOOKED","toState": "IN_PROGRESS","trigger": "DEPARTED","label": "Departed"},
      {"fromState": "IN_PROGRESS","toState": "COMPLETED","trigger": "RETURNED","label": "Returned"},
      {"fromState": "BOOKED","toState": "CANCELLED","trigger": "CANCELLED","label": "Cancelled"}
    ],
    "initialState": "PLANNING"
  },
  "reminderRules": [
    {"ruleId": "visa_expiry_reminder","title": "Visa Expiry","triggerField": "visa_expiry","offsetDays": -60,"priority": "HIGH","messageTemplate": "Travel visa expires in 60 days"},
    {"ruleId": "departure_reminder","title": "Departure","triggerField": "departure_date","offsetDays": -3,"priority": "MEDIUM","messageTemplate": "Upcoming departure in 3 days"}
  ],
  "searchConfig": {"primaryFields": ["destination","booking_reference","airline"],"fullTextFields": ["destination","airline","booking_reference"],"filterableFields": ["travel_type","visa_required"]},
  "aiConfig": {"extractableFields": ["destination","departure_date","return_date","booking_reference","airline"],"classificationHints": ["travel","flight","visa","booking","itinerary"]}
}
